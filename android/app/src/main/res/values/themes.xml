<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only, like AniBox on the PC. Compose draws everything; this is the window behind it. -->
    <style name="Theme.AniBox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.AniBox.Player" parent="Theme.AniBox">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>

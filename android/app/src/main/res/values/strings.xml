    <!-- setup -->
    <string name="setup_kicker">Phone app</string>
    <string name="setup_title">Connect to your library</string>
    <string name="setup_intro">AniBox on your PC writes your library into an “AniBox Sync” folder on one of the Shield\'s drives. This app reads it from there and plays the episodes straight from the Shield.</string>
    <string name="setup_scan">Scan the QR code</string>
    <string name="setup_scan_hint">On the PC: AniBox → Settings → Phone app.</string>
    <string name="setup_paste">Paste the code\'s text</string>
    <string name="setup_paste_hint">The same page on the PC can copy the code as text.</string>
    <string name="setup_type">Type it in</string>
    <string name="setup_type_hint">The Shield\'s name, the drive\'s share and the folder.</string>
    <string name="setup_privacy">Only the sync folder and the episodes are read. Your watch progress is written into the sync folder for the PC; nothing goes anywhere else.</string>
    <string name="setup_scan_where">Open AniBox on the PC, then Settings → Phone app, and point the camera at the code.</string>
    <string name="setup_camera_why">The camera is only used to read the code, while this page is open.</string>
    <string name="setup_camera_refused">Without the camera the code can\'t be scanned. You can paste its text instead.</string>
    <string name="setup_camera_allow">Use the camera</string>
    <string name="setup_paste_instead">Paste the text instead</string>
    <string name="setup_paste_where">On the PC: AniBox → Settings → Phone app shows the code\'s text. Copy it into this box.</string>
    <string name="setup_type_where">As Windows shows the folder: \\\\NAME\\Share\\Folder. If you name the folder that holds “AniBox Sync”, that\'s fine too.</string>
    <string name="setup_host">The Shield\'s name or address</string>
    <string name="setup_host_hint">e.g. MEDIABOX</string>
    <string name="setup_share">Share (drive)</string>
    <string name="setup_share_hint">e.g. Drive A</string>
    <string name="setup_folder">Folder</string>
    <string name="setup_folder_hint">e.g. Anime/AniBox Sync</string>
    <string name="setup_signin_kicker">Sign in</string>
    <string name="setup_signin_title">The share\'s user name and password</string>
    <string name="setup_from_pc">Written by %1$s</string>
    <string name="setup_signin_where">The Shield shows them under Settings → Device Preferences → Storage → Transfer files over local network. The same sign-in is used for every drive of this Shield.</string>
    <string name="setup_user">User name</string>
    <string name="setup_password">Password</string>
    <string name="setup_password_show">Show the password</string>
    <string name="setup_password_hide">Hide the password</string>
    <string name="setup_address">Address of %1$s</string>
    <string name="setup_address_hint">e.g. 192.168.0.20</string>
    <string name="setup_connect">Connect</string>
    <string name="setup_testing">Looking at the folder…</string>
    <string name="setup_password_note">The password stays on this phone, encrypted with a key that only this phone has. It never goes into the sync folder and isn\'t part of the phone\'s backups.</string>


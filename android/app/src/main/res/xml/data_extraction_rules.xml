<?xml version="1.0" encoding="utf-8"?>
<!-- What Android's backup and phone-to-phone transfer leave out (Android 12+; backup_rules.xml for older). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="signin.json" />
        <exclude domain="file" path="device.json" />
        <exclude domain="file" path="posters" />
        <exclude domain="file" path="mpv" />
        <exclude domain="file" path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="signin.json" />
        <exclude domain="file" path="device.json" />
        <exclude domain="file" path="posters" />
        <exclude domain="file" path="mpv" />
        <exclude domain="file" path="logs" />
    </device-transfer>
</data-extraction-rules>
